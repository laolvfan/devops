{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B11 DRAFT 逐轮记录初稿",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "producer_job_id",
    "repository",
    "rounds"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "enum": [
        "MANUAL_EXAMPLE",
        "DRAFT_EXECUTION"
      ]
    },
    "producer_job_id": {
      "type": "string",
      "pattern": "^job-DRAFT-[^\\s]+$"
    },
    "repository": {
      "type": "object",
      "required": [
        "url",
        "commit"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        }
      }
    },
    "rounds": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "iteration",
          "changes",
          "reason",
          "image_build",
          "build",
          "verification"
        ],
        "properties": {
          "iteration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "summary"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "image_build": {
            "$ref": "#/$defs/step"
          },
          "build": {
            "$ref": "#/$defs/step"
          },
          "verification": {
            "$ref": "#/$defs/step"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "image_build": {
                  "properties": {
                    "status": {
                      "not": {
                        "const": "PASSED"
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "build": {
                  "properties": {
                    "status": {
                      "const": "NOT_RUN"
                    }
                  }
                },
                "verification": {
                  "properties": {
                    "status": {
                      "const": "NOT_RUN"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "build": {
                  "properties": {
                    "status": {
                      "not": {
                        "const": "PASSED"
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "verification": {
                  "properties": {
                    "status": {
                      "const": "NOT_RUN"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "command",
        "status",
        "exit_code",
        "log_uri"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "PASSED",
            "FAILED",
            "NOT_RUN",
            "INTERRUPTED"
          ]
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "log_uri": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^artifact://[^/\\s]+/[^/\\s]+/[^\\s]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASSED"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "type": "null"
              },
              "log_uri": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "exit_code": {
                "not": {
                  "const": 0
                }
              }
            }
          }
        }
      ]
    }
  }
}
