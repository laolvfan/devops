{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "B11 MD/RD 报告 1.0.0 初稿",
  "description": "ERROR_REPORT 文件内容。待 A11 确认；MDFixer 只选择 MISSING。跨字段一致性由业务校验负责。",
  "type": "object",
  "required": ["schema_version", "repository", "configuration_id", "producer_job_id", "detector", "findings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "repository": {
      "type": "object",
      "required": ["url", "commit"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/commit"}
      }
    },
    "configuration_id": {"type": "string", "pattern": "^cfg-[^-\\s]+-[^-\\s]+-[^-\\s]+-[^-\\s]+$"},
    "producer_job_id": {"type": "string", "pattern": "^job-(DRAFT|FULL_CHECK|INCREMENTAL_CHECK|REPAIR)-[^\\s]+$"},
    "detector": {
      "enum": ["BUILDCHECKER", "ECHECKER", "INSTRUCTOR_ORACLE", "MANUAL_EXAMPLE"],
      "description": "报告的实际来源；人工示例不得标为真实检测器输出。"
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "delta": {
      "type": "object",
      "required": ["base_commit", "added", "resolved"],
      "properties": {
        "base_commit": {"$ref": "#/$defs/commit"},
        "added": {"$ref": "#/$defs/findingIds"},
        "resolved": {"$ref": "#/$defs/findingIds"}
      }
    }
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "text": {"type": "string", "minLength": 1},
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$",
      "description": "仓库根目录相对路径，使用 /，不包含 .. 路径段；实际路径解析仍需业务校验。"
    },
    "findingIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    },
    "finding": {
      "type": "object",
      "required": ["finding_id", "type", "target", "dependency", "commit", "location", "evidence"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/text"},
        "type": {"enum": ["MISSING", "REDUNDANT"]},
        "target": {"$ref": "#/$defs/text"},
        "dependency": {"$ref": "#/$defs/text"},
        "commit": {"$ref": "#/$defs/commit"},
        "location": {
          "type": "object",
          "required": ["path", "line"],
          "properties": {
            "path": {"$ref": "#/$defs/relativePath"},
            "line": {"type": "integer", "minimum": 1}
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "description"],
            "properties": {
              "kind": {"enum": ["FILE_READ", "DECLARATION", "ANALYSIS"]},
              "description": {"$ref": "#/$defs/text"},
              "path": {"$ref": "#/$defs/text"},
              "command": {"$ref": "#/$defs/text"},
              "declared_dependencies": {"type": "array", "items": {"$ref": "#/$defs/text"}}
            }
          }
        }
      }
    }
  }
}
